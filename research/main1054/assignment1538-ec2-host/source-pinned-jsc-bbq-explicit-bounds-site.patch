+void BBQJIT::throwExceptionIf(ExceptionType type, Jump jump)
+{
+    if (type == ExceptionType::OutOfBoundsMemoryAccess && m_parser) {
+        // This JIT branch's source origin is known now, but would otherwise
+        // be lost when all out-of-bounds jumps share the final cold handler.
+        m_diagnosticBoundsSites.append({ jump, static_cast<uint32_t>(m_parser->currentOpcodeStartingOffset()) });
+        return;
+    }
+    m_exceptions[static_cast<unsigned>(type)].append(jump);
+}
 
