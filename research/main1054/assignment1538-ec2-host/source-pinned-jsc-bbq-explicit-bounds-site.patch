+    // This writes the site marker only AFTER the real bounds branch is taken,
+    // before normal JSC exception dispatch. No JS/ONNX/model changes.
+    for (auto& site : m_diagnosticBoundsSites) {
+        site.branch.link(&jit);
+        jit.store32(CCallHelpers::TrustedImm32(static_cast<int32_t>(site.functionRelativeOpcode)),
+            CCallHelpers::Address(GPRInfo::wasmContextInstancePointer, JSWebAssemblyInstance::offsetOfDiagnosticOOBOpcode()));
+        emitThrowException(ExceptionType::OutOfBoundsMemoryAccess);
+    }
