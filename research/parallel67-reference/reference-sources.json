  "prototypeDifferences": [
    "ONNX Florence-2-base-ft replaces reference microsoft/Florence-2-large.",
    "ONNX SAM2.1 Hiera tiny replaces reference Hiera large checkpoint.",
    "Transformers.js CPU/WASM q8 replaces PyTorch GPU path.",
    "Model sizes, architecture variant, precision/runtime and prompt behavior differ; this is a reference-pattern port, not exact-model reproduction or transferred accuracy."
  ],
  "licenseGates": [
    "Florence conversion declares MIT and upstream publisher ships LICENSE. Preserve copyright/license when redistributing.",
    "SAM2 conversion repository has no model card or declared license. Upstream Meta model declares Apache-2.0; confirm conversion provenance/notices or reproduce export from licensed pinned upstream before redistribution.",
    "Hugging Face API LFS digests are source metadata; verify downloaded graph AND external-data bytes against them before claiming integrity."
  ],
  "sam2JSContract": {
    "runtime": "@huggingface/transformers 3.8.1 source inspected locally",
    "imports": [
      "AutoProcessor",
      "Sam2Model",
      "RawImage"
    ],
    "boxes": "processor(image,{input_boxes:[[[x1,y1,x2,y2],...]]}) using original image pixel coordinates, batch x num_boxes x4; processor rescales them.",
    "inference": "Sam2Model.from_pretrained(id,{revision,dtype:q8,device:cpu or wasm,use_external_data_format:true}); await model(inputs). Verify option support/runtime on actual execution.",
    "outputs": "pred_masks [batch,num_boxes_or_points,3,256,256], iou_scores [batch,num_boxes_or_points,3], object_score_logits [batch,num_boxes_or_points,1].",
    "postprocess": "processor.post_process_masks(outputs.pred_masks,inputs.original_sizes,inputs.reshaped_input_sizes); choose mask using model iou score, not ground truth.",
    "constraint": "SAM2 only segments prompted boxes; SAM2 scores do not validate clothing category/subtype or independently detected-instance recall."
  },
  "accuracyClaim": "None. Public upstream examples demonstrate an architecture pattern, not garment recognition accuracy on this cohort or mobile acceptance."
}
